# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# Your API-Football key (from https://dashboard.api-football.com). Required.
API_FOOTBALL_KEY=

# Time zone used to decide what "today" means and to request fixture times.
# Use an IANA name, for example Asia/Kolkata or Europe/London.
APP_TIMEZONE=UTC

# How often (seconds) open pages refresh while a match is live.
# Lower values use more of your daily API quota.
LIVE_REFRESH_SECONDS=60

# Optional: override the API base URL (only for local testing against a mock server).
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
